{
  "context": {
    "fileName": [
      "AGENTS.md",
      "GEMINI.md"
    ]
  },
  "mcpServers": {
    "mosaik": {
      "command": "yarn",
      "args": [
        "exec",
        "mosaik-mcp"
      ],
      "cwd": "."
    },
    "nx-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "nx",
        "mcp"
      ]
    }
  }
}
