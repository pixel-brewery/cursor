{
    "name": "api-docs",
    "projectType": "application",
    "implicitDependencies": [
        "cursor-core",
        "@pixel-brewery/cursor-angular",
        "@pixel-brewery/cursor-browser",
        "@pixel-brewery/cursor-react",
        "@pixel-brewery/cursor-svelte",
        "@pixel-brewery/cursor-vue"
    ],
    "targets": {
        "generate": {
            "executor": "@pixel-brewery/cursor-workspace-tools:api-docs",
            "dependsOn": ["^build"],
            "cache": false,
            "outputs": ["{workspaceRoot}/.docs/api", "{workspaceRoot}/.docs/packages/*/api"],
            "options": { "mode": "write" }
        },
        "check": {
            "executor": "@pixel-brewery/cursor-workspace-tools:api-docs",
            "dependsOn": ["^build"],
            "cache": false,
            "options": { "mode": "check" }
        }
    }
}
