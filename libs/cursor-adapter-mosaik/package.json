{
    "name": "@pixel-brewery/cursor-adapter-mosaik",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./components/*": {
            "types": "./dist/components/*/index.d.ts",
            "default": "./dist/components/*/index.js"
        }
    },
    "sideEffects": false,
    "scripts": {
        "build": "tsc -b",
        "test": "tsc -p tsconfig.spec.json && vitest run"
    },
    "dependencies": {
        "@pixel-brewery/cursor-browser": "workspace:^"
    },
    "devDependencies": {
        "@pixel-brewery/mosaik-elements-foundation": "0.1.213"
    }
}
