{
    "name": "@pixel-brewery/cursor-workspace",
    "private": true,
    "version": "0.0.0",
    "description": "Framework-neutral TypeScript tooling for shared pointers and guided actions.",
    "type": "module",
    "packageManager": "yarn@4.18.1",
    "engines": {
        "node": ">=24.15.0"
    },
    "workspaces": [
        "libs/*",
        "apps/*"
    ],
    "scripts": {
        "agents:sync": "node tools/sync-agents.mjs --write",
        "agents:check": "node tools/sync-agents.mjs --check && node tools/check-bootstrap.mjs",
        "agents:mcp-check": "node tools/check-mosaik-mcp.mjs",
        "typecheck": "tsc --project tsconfig.json --noEmit"
    },
    "devDependencies": {
        "@pixel-brewery/mosaik-mcp": "0.1.205",
        "nx": "24.0.5",
        "typescript": "6.0.3"
    }
}
