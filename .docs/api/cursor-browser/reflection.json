      "flags": {
        "isPublic": true
      },
      "signatures": [
        {
          "id": 2,
          "name": "attachCursorSurface",
          "variant": "signature",
          "kind": 4096,
          "flags": {
            "isPublic": true
          },
          "comment": {
            "summary": [
              {
                "kind": "text",
                "text": "Mounts the shared pointer renderer on a connected browser or Electron surface."
              }
            ],
            "blockTags": [
              {
                "tag": "@remarks",
                "content": [
                  {
                    "kind": "text",
                    "text": "The overlay observes the attached view without handling pointer input or taking focus\nfrom host controls. The host owns the lifetime of the returned attachment and the supplied\ncontroller. Dispose the attachment before a view change or unmount."
                  }
                ]
              },
              {
                "tag": "@returns",
                "content": [
                  {
                    "kind": "text",
                    "text": "An attachment that owns overlay cleanup and target registration."
                  }
                ]
              },
              {
                "tag": "@throws",
                "content": [
                  {
                    "kind": "text",
                    "text": "If the surface has no connected browser document with a body and a window."
                  }
                ]
              },
              {
                "tag": "@example",
                "content": [
                  {
                    "kind": "code",
                    "text": "```ts\nconst binding = attachCursorSurface({ surface, controller });\nconst releaseSettings = binding.registerTarget('settings', settingsButton);\nreleaseSettings();\nbinding.dispose();\n```"
                  }
                ]
              }
            ]
          },
          "parameters": [
            {
              "id": 3,
              "name": "options",
              "variant": "param",
              "kind": 32768,
              "flags": {},
              "comment": {
                "summary": [
                  {
                    "kind": "text",
                    "text": "The host surface, view controller and optional projection settings."
                  }
                ]
              },
              "type": {
                "type": "reference",
                "target": 13,
                "name": "ICursorSurfaceOptions",
                "package": "@pixel-brewery/cursor-browser"
              }
            }
          ],
          "type": {
            "type": "reference",
            "target": 4,
            "name": "ICursorSurface",
            "package": "@pixel-brewery/cursor-browser"
          }
        }
      ]
    },
    {
      "id": 4,
      "name": "ICursorSurface",
      "variant": "declaration",
      "kind": 256,
      "flags": {
        "isPublic": true
      },
      "comment": {
        "summary": [
          {
            "kind": "text",
            "text": "A mounted cursor overlay and its target registrations."
          }
        ]
      },
      "children": [
        {
          "id": 11,
          "name": "dispose",
          "variant": "declaration",
          "kind": 2048,
          "flags": {
            "isPublic": true
          },
          "signatures": [
            {
              "id": 12,
              "name": "dispose",
              "variant": "signature",
              "kind": 4096,
              "flags": {
                "isPublic": true
              },
              "comment": {
                "summary": [
                  {
                    "kind": "text",
                    "text": "Withdraws the local pointer, removes the overlay and releases subscriptions, listeners,\nobservers and target registrations. Cancels an active presentation."
                  }
                ],
                "blockTags": [
                  {
                    "tag": "@remarks",
                    "content": [
                      {
                        "kind": "text",
                        "text": "Call on unmount or before replacing the host view or controller. Repeated calls\nhave no effect. The caller continues to own the controller."
                      }
                    ]
                  }
                ]
              },
              "type": {
                "type": "intrinsic",
                "name": "void"
              }
            }
          ]
        },
        {
          "id": 5,
          "name": "registerTarget",
          "variant": "declaration",
          "kind": 2048,
          "flags": {
            "isPublic": true
          },
          "signatures": [
            {
              "id": 6,
              "name": "registerTarget",
              "variant": "signature",
              "kind": 4096,
              "flags": {
                "isPublic": true
              },
              "comment": {
                "summary": [
                  {
                    "kind": "text",
                    "text": "Registers a live element under its stable host target ID."
                  }
                ],
                "blockTags": [
                  {
                    "tag": "@returns",
                    "content": [
                      {
                        "kind": "text",
                        "text": "An idempotent cleanup function for this registration. Releasing an active target\ncancels its presentation and removes the assistant marker."
                      }
                    ]
                  },
                  {
                    "tag": "@throws",
                    "content": [
                      {
                        "kind": "text",
                        "text": "If the element lies outside the surface, the attachment or controller is\ndisposed, or the identifier is invalid or already registered on the controller."
                      }
                    ]
                  }
                ]
              },
