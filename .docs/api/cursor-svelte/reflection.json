      "comment": {
        "summary": [
          {
            "kind": "text",
            "text": "Attach the browser renderer when a Svelte action mounts."
          }
        ],
        "blockTags": [
          {
            "tag": "@remarks",
            "content": [
              {
                "kind": "text",
                "text": "Changing the controller or local pointer visibility disposes the previous attachment.\nDestruction releases the renderer and reports "
              },
              {
                "kind": "code",
                "text": "`null`"
              },
              {
                "kind": "text",
                "text": " through "
              },
              {
                "kind": "code",
                "text": "`onAttachment`"
              },
              {
                "kind": "text",
                "text": ".\nReplacing the callback ends the previous observation and reports the current attachment\nto the new observer. The host owns the controller."
              }
            ]
          }
        ]
      },
      "type": {
        "type": "reference",
        "target": {
